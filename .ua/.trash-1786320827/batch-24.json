    {
      "id": "file:gateway/src/services/a2a-worker.ts",
      "type": "file",
      "name": "a2a-worker.ts",
      "filePath": "gateway/src/services/a2a-worker.ts",
      "summary": "A2A（Agent-to-Agent）后台工作线程，定时轮询链上任务队列并执行编排处理，可将任务分派给子代理、调用 LLM 工具并写回任务结果。",
      "tags": ["service", "worker", "orchestration", "a2a", "background-job"],
      "complexity": "complex",
      "languageNotes": "基于 setInterval 轮询 + 深度递归的 processTask 实现多层子代理编排，LLM 调用带 AbortSignal.timeout 超时控制。"
    },
    {
      "id": "file:gateway/src/services/agent-indexer.ts",
