    {
      "id": "file:frontend/hooks/useAgentChat.ts",
      "type": "file",
      "name": "useAgentChat.ts",
      "filePath": "frontend/hooks/useAgentChat.ts",
      "summary": "Agent 对话核心 hook，通过 @agentxv2/sdk 的 ConversationClient 与 Gateway 通信，支持并行任务模式（会话+任务轮询）与单轮 SSE 流式两种执行方式，覆盖会话创建/续接、任务轮询、流式增量、工具调用、思考文本与链上授权回调。",
      "tags": ["hook", "chat", "streaming", "sse", "agent-sdk"],
      "complexity": "complex",
      "languageNotes": "以大量 useRef 管理轮询定时器、已浮现任务集合与 abort 控制器，SSE 流式与任务轮询双模式并存，并对平台/BYOK 两种 LLM key 模式做处理。"
    },
    {
      "id": "function:frontend/hooks/useAgentChat.ts:useAgentChat",
      "type": "function",
      "name": "useAgentChat",
      "filePath": "frontend/hooks/useAgentChat.ts",
      "lineRange": [66, 410],
      "summary": "对话主 hook：管理消息/流式/思考文本/会话状态，封装创建会话、启动任务轮询、发送消息（流式或建任务）、取消任务、清空对话等操作，并通过 options 回调把文本增量、工具调用、思考、完成/错误/链上授权等事件上报给调用方。",
      "tags": ["hook", "chat", "state-management", "polling", "streaming"],
      "complexity": "complex"
    },
    {
