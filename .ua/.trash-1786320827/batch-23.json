      "lineRange": [59, 68],
      "summary": "统一查询 tenants（LEFT JOIN plans）并返回首行或 null，供 verifyChallenge、authMiddleware 与 apiKeyAuth 三条认证路径复用。",
      "tags": ["查询", "数据库", "认证"],
      "complexity": "simple"
    },
    {
      "id": "function:gateway/src/middleware/auth.ts:rowToTenant",
      "type": "function",
      "name": "rowToTenant",
      "filePath": "gateway/src/middleware/auth.ts",
      "lineRange": [70, 85],
      "summary": "将 tenants 查询行映射为 TenantContext 对象，包含 plan、配额、kind（user/partner）及 P9 并行任务能力位等字段。",
      "tags": ["映射", "数据模型", "认证"],
      "complexity": "simple"
    },
    {
      "id": "function:gateway/src/middleware/auth.ts:getChallenge",
      "type": "function",
      "name": "getChallenge",
      "filePath": "gateway/src/middleware/auth.ts",
      "lineRange": [125, 139],
      "summary": "处理 GET /auth/challenge，按钱包地址生成随机 nonce 的 challenge 消息并存储（Redis 优先、内存 Map 回退）。",
      "tags": ["api-handler", "认证", "challenge"],
      "complexity": "simple"
    },
    {
      "id": "function:gateway/src/middleware/auth.ts:verifyChallenge",
      "type": "function",
      "name": "verifyChallenge",
      "filePath": "gateway/src/middleware/auth.ts",
      "lineRange": [141, 232],
      "summary": "处理 POST /auth/verify，用 ethers 校验 EIP-191 签名与 nonce、加载或自动创建 tenant（补发/生成 api_key），并签发 JWT 会话令牌返回。",
      "tags": ["api-handler", "认证", "jwt", "签名"],
      "complexity": "complex"
    },
    {
      "id": "function:gateway/src/middleware/auth.ts:authMiddleware",
      "type": "function",
      "name": "authMiddleware",
      "filePath": "gateway/src/middleware/auth.ts",
