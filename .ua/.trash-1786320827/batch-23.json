      "lineRange": [17, 19],
      "summary": "使用主密钥对密文 API key 进行 AES-256-GCM 解密，委托 SDK 的 decryptWithKey 实现。",
      "tags": ["工具函数", "解密", "crypto"],
      "complexity": "simple"
    },
    {
      "id": "function:gateway/src/middleware/auth.ts:queryTenant",
      "type": "function",
      "name": "queryTenant",
