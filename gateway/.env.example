# =============================================================================
# AgentX Gateway — Environment Configuration Template
# =============================================================================
# Copy to .env and fill in actual values before starting the service.
# =============================================================================

# --- Server ----------------------------------------------------------------
PORT=3090
NODE_ENV=production

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3100

# Admin API key (used by X-Admin-Key / Bearer header in admin routes)
ADMIN_KEY=change-me-to-a-random-admin-key

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://agentx:agentx@localhost:5432/agentx_gateway

# --- Redis (rate limiting & sessions) --------------------------------------
REDIS_URL=redis://localhost:6379

# --- JWT (generate: openssl rand -hex 32) ----------------------------------
JWT_SECRET=change-me-to-a-random-secret

# --- Master encryption key for tenant API keys at rest (hex, 32 bytes) -----
MASTER_ENCRYPTION_KEY=change-me-to-a-random-32-byte-hex-key

# --- Session TTL (seconds) -------------------------------------------------
SESSION_TTL_SEC=86400

# --- Blockchain: Sepolia ---------------------------------------------------
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
IDENTITY_REGISTRY=0xe94ad380d3F8d08a7590eda0C84f354a93F96e5F
SUBSCRIPTION_MANAGER=0xC15fE80b9d800abb72121F353a6ae6d6E9077E63
A2A_PROTOCOL=0x309C7447d89f3087A9924BB686d88df020F7e9cB
REPUTATION_REGISTRY=0xeb6B410ea71b8d9dA0c96f6A91d35027CE143DC9
CONFIGURATION_REGISTRY=0x68DcE00e4C9077c94BC68016cD14B09557faEA6c
MULTI_ENDPOINT=0xEB5e866f186d4B73F97aa0d70B86f2C6e2e21Cb7

# --- Blockchain: OxaChain L1 -----------------------------------------------
RPC_URL_OXACHAIN=https://rpc-oxa.0xainet.top
CHAIN_ID_OXACHAIN=19505
IDENTITY_REGISTRY_OXACHAIN=0xbf5F9db266c8c97E3334466C88597Eb758AfE212
SUBSCRIPTION_MANAGER_OXACHAIN=0x019AC9d945467478Dd371CDbD70cb2f325800E6B
A2A_PROTOCOL_OXACHAIN=0x7F42a7dC4A0F3C107664C3750bE1B5B6fa6BEb86
REPUTATION_REGISTRY_OXACHAIN=0x6a18C2664E1b42063860d864b6448b824d7B843F
CONFIGURATION_REGISTRY_OXACHAIN=0x07280674ccc2898Fd038A9e3C22005CA83ffD2F8
MULTI_ENDPOINT_OXACHAIN=0xB361d04F49000013FC131D3C59C41c8486C64f8c

# --- x402 (pay-per-request) ---
# X402_ENABLED=true 时启用；verify 校验链上转账入账 x402_balances。
X402_ENABLED=false
X402_PAY_TO=0x0000000000000000000000000000000000000000
X402_PRICE_WEI=1000000000000000
X402_CHAIN=oxachain
# OE-5: InfraXEscrow 金库托管地址（infraX projects/escrow 部署）。配置后充值资金进金库，
# verify 校验 tx.to==escrow + Deposited 事件入账（余额锚在链上，ledger 为索引/对账层）。
# 留空 = 保持直转 X402_PAY_TO（EOA）兼容。
X402_ESCROW_ADDRESS=

# --- Agent Payer (t8): agent 自主钱包自动代付（InfraX MPC 钱包）------------
# 部署 infraX projects/mpc 服务后配置以下两项；未配置时 agent-payer 能力禁用，
# A2A 委派余额不足走人工付款（awaiting_payment + resume）。
MPC_SERVER_URL=
MPC_API_KEY=

# --- A2A Worker wallet ---
# ⚠️ 已废弃（2026-08-08）：Gateway 不再持有任何签名密钥。
# 链上 A2A 轨道由用户自己的钱包签 createTask（用户付 gas，成为链上 client）。
# 该变量已从 config.ts 移除，无需配置，可删除；a2a-worker 只读链、子任务链下内联处理。
# A2A_WORKER_PRIVATE_KEY=

# --- Conversation Service (agent dialogue microservice) ---------------------
CONVERSATION_SERVICE_URL=http://127.0.0.1:8100
CONVERSATION_SERVICE_TOKEN=agentx-conv-internal-token-2026

# --- Internal orchestration (off-chain multi-agent delegation) --------------
# Shared secret the Conversation Service uses to call /api/v1/internal/orchestrate
# (list/check only — create-task 路由已移除 2026-08-08)。Must match the Conversation Service's ORCHESTRATE_TOKEN.
ORCHESTRATE_TOKEN=change-me-match-conversation-service

# --- ERC-4337 Auto-Renew (t9) ----------------------------------------------
# 链上订阅自动续订：用户一次授权（Kernel ENABLE-mode）后网关用 session key 续订。
# 依赖 infraX aa-relay（AA_SDK_TECH_DESIGN §8.3）与 @0xinfrax/aa-sdk@0.1.1。
# AA_RELAY_API_KEY 与 aa-relay 服务的 AA_RELAY_API_KEY 一致（infrax PRODUCTION_CREDENTIALS）。
# AA_DEPLOYER_PRIVATE_KEY = 平台操作员私钥（oxachain 有余额），一次性代付 Kernel 账户部署 gas。
AA_AUTO_RENEW_ENABLED=false
AA_RELAY_URL=https://rpc-gw.0xainet.top/aa-relay/
AA_RELAY_API_KEY=
AA_RELAY_CHAIN=oxachain
AA_AUTO_RENEW_INTERVAL_SEC=3600
AA_AUTO_RENEW_WINDOW_SEC=86400
AA_AUTO_RENEW_SESSION_DAYS=730
AA_AUTO_RENEW_MAX_COUNT=366
AA_DEPLOYER_PRIVATE_KEY=
# 资金巡检（e4）：到期前提前告警窗口（默认 3 天）/ 同一登记两次告警最小间隔（默认 1 天）/ 可选告警 webhook
AA_ALERT_AHEAD_SEC=259200
AA_ALERT_MIN_INTERVAL_SEC=86400
AA_ALERT_WEBHOOK_URL=
# escrow 计费对账（e5）：事件同步间隔 / 单轮最大区块跨度 / 漏计费与重复扣费判定容差
AA_ESCROW_RECONCILE_INTERVAL_SEC=3600
AA_ESCROW_SYNC_BLOCK_SPAN=5000
AA_ESCROW_RECONCILE_MIN_RATIO=0.5
AA_ESCROW_RECONCILE_MAX_RATIO=3
# Kernel v3 oxachain AA 栈（生产地址默认，无需改动）
AA_OXACHAIN_ENTRYPOINT_V07=0x97e4cddcffeaf4580bc6315fee512f2b2d82798a
AA_OXACHAIN_IMPLEMENTATION=0x5131d75af2126eba05edbb6bc24902c42d1b52b4
AA_OXACHAIN_FACTORY=0xf8abe4510a6810d5ef26aa3222c0f63d32b757d1
AA_OXACHAIN_ECDSA_VALIDATOR=0xb0d4f548e022b8a9d5b454ffb7f327ee2afeb16c
AA_OXACHAIN_SESSION_MODULE=0xfbbca78d2d7d08c1163aa57a0056973ef4fd8c74
