# Copy to e2e/.env — .env is git-ignored, never commit real keys.
#
# The test wallet MUST hold:
#   1) a fiat subscription for agent 1 (see e2e/sql/ setup)  —  chat billing
#   2) an ACTIVE on-chain subscription for agent 1 (e2e/onchain/subscribe.cjs --run)
# otherwise /user/chat/1 renders the SubscriptionGuard paywall.

# C-end site under test
SITE=https://agentx.0xainet.top

# Test wallet (funded; used for injected window.ethereum signing + RPC txs)
TEST_WALLET_PK=0x...
TEST_ACCOUNT=0x...

# OXA chain (19505 = 0x4c31)
TEST_CHAIN_ID=19505

# Local TLS tunnel -> remote RPC (start before running):
#   ssh -L 19506:rpc-oxa.0xainet.top:443 <host>   (or your tunnel of choice)
RPC_TUNNEL_HOST=127.0.0.1
RPC_TUNNEL_PORT=19506
RPC_HOST=rpc-oxa.0xainet.top

# Headless Chromium binary (playwright-core does not bundle a browser)
CHROME_PATH=/path/to/chrome

# Optional CJK font config (fonts.conf) to render Chinese text in headless screenshots
FONT_CONFIG_DIR=/path/to/fontconf

# Optional Chromium shared-lib path (e.g. bundled libstdc++/fontconfig in CI/containers)
CHROMIUM_LD_LIBRARY_PATH=/path/to/lib-dir

# Screenshots/artifacts output
SHOTS_DIR=e2e/shots
