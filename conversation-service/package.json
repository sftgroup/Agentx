{
  "name": "@agentxv2/conversation",
  "version": "0.1.0",
  "description": "AgentX Conversation Service — Multi-tenant AgentLoop execution engine (Memory + Context + Skills)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node -e \"const{execSync}=require('child_process');execSync('psql '+process.env.DATABASE_URL+' -f migrations/001_memory.sql',{stdio:'inherit'});execSync('psql '+process.env.DATABASE_URL+' -f migrations/002_traces.sql',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@agentxv2/sdk": "0.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
