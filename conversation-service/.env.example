# AgentX Conversation Service — Environment Variables
# Copy to .env and fill in your values

# Server
PORT=8100
NODE_ENV=development

# Database (PostgreSQL with pgvector extension)
DATABASE_URL=postgresql://localhost:5432/agentx_conversation

# Internal auth between Gateway and Conversation Service
INTERNAL_AUTH_TOKEN=change-me-in-production

# OpenAI API Key (optional — for embedding generation in Memory engine)
# Missing → falls back to time-sorted recall
OPENAI_API_KEY=

# Embedding model and API URL (configurable for non-OpenAI providers)
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings

# Context compaction model (for LLM-based summarization)
COMPACT_MODEL=gpt-4o-mini

# RPC endpoints for reading agent data from blockchain
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_OXACHAIN=https://rpc-oxa.0xainet.top

# Contract addresses (Sepolia)
IDENTITY_REGISTRY=0xe94ad380d3F8d08a7590eda0C84f354a93F96e5F

# Contract addresses (OxaChain L1)
IDENTITY_REGISTRY_OXACHAIN=0xbf5F9db266c8c97E3334466C88597Eb758AfE212

# AgentRunner context TTL (seconds)
CONTEXT_CACHE_TTL_SEC=300

# Sandbox (optional — Phase 6)
SANDBOX_DOCKER_IMAGE=node:20-alpine
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MAX_MEMORY_MB=256
