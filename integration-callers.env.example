# ============================================================
# AgentX 多调用方接入配置模板（通用占位版）
# 用途：分发给各调用方团队，填写各自 Key 后使用
# 生成时间：2026-08-06
#
# 统一 Gateway 地址：https://agentx.0xainet.top
# 鉴权方式：请求头 X-Api-Key: <key>
# 详细接入说明见同目录 docs/integration-callers.md
#
# ⚠️ 请将 <your-key> 替换为平台签发的真实 Key 后使用，
#    真实 Key 仅由平台管理员在 Admin → Integrations 中签发/轮换。
# ============================================================

# ── 1. aitrader ──────────────────────────────────────────────────
AGENTX_GATEWAY_URL=https://agentx.0xainet.top
AGENTX_CONVERSATION_API_KEY=agentx_<aitrader-your-key>
# tenant: partner-aitrader

# ── 2. aiservicer ───────────────────────────────────────────────
AGENTX_GATEWAY_URL=https://agentx.0xainet.top
AGENTX_CONVERSATION_API_KEY=agentx_<aiservicer-your-key>
# tenant: partner-aiservicer

# ── 3. aihunter-saas ────────────────────────────────────────────
AGENTX_GATEWAY_URL=https://agentx.0xainet.top
AGENTX_CONVERSATION_API_KEY=agentx_<aihunter-saas-your-key>
# tenant: partner-aihunter-saas

# ── 4. autoops ──────────────────────────────────────────────────
AGENTX_GATEWAY_URL=https://agentx.0xainet.top
AGENTX_CONVERSATION_API_KEY=agentx_<autoops-your-key>
# tenant: partner-autoops

# ── 5. aiops-saas ───────────────────────────────────────────────
AGENTX_GATEWAY_URL=https://agentx.0xainet.top
AGENTX_CONVERSATION_API_KEY=agentx_<aiops-saas-your-key>
# tenant: partner-aiops-saas

# ── 快速验证 ─────────────────────────────────────────────────────
# 替换 Key 后执行：
#   curl -H "X-Api-Key: <your-key>" https://agentx.0xainet.top/api/v1/tenant/me
# 返回 200 且 tenant.wallet_address = partner-<调用方 slug> 即配置正确。

# ── SDK 接入示例（@agentxv2/sdk ≥0.8.8）─────────────────────────
#   import { ConversationClient } from '@agentxv2/sdk'
#   const client = new ConversationClient({
#     gatewayUrl: process.env.AGENTX_GATEWAY_URL!,
#     apiKey: process.env.AGENTX_CONVERSATION_API_KEY!,  // X-Api-Key 鉴权
#   })
